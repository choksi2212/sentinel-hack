# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Nothing in this repository reads a credential from a source file, a YAML config
# or a command-line argument. Environment only. A password in config/live.yaml is
# a password in the git history forever, and rotating it after submission does not
# remove it from the clone a judge already made.

# --- Sentinel live grid ------------------------------------------------------
# The organisers' HLS feed is password-protected. The catalogue at
# https://cctv.corp8.cloud/cameras.json lists cam01..cam30.
SENTINEL_HLS_USERNAME=
SENTINEL_HLS_PASSWORD=

# RTSP on 103.250.160.189:8554 is the path the AI worker uses, over TCP.
# Leave blank if the RTSP endpoint is open.
SENTINEL_RTSP_USERNAME=
SENTINEL_RTSP_PASSWORD=

# --- database ----------------------------------------------------------------
# Owned by the backend, listed here because scripts/ and the benchmark harness
# read it. PostGIS is required, not optional -- the camera geometry and the
# journey queries are spatial.
TRINETRA_DB_HOST=localhost
TRINETRA_DB_PORT=5432
TRINETRA_DB_NAME=trinetra
TRINETRA_DB_USER=postgres
TRINETRA_DB_PASSWORD=

# --- ingest ------------------------------------------------------------------
# Where the AI worker POSTs sighting events. Contracts section 5.
#
# ORIGIN ONLY -- no path. HttpEventSink appends the contract's own path,
# /api/v1/ingest/events, because a per-machine setting that could point the worker at a
# different endpoint is one that can deliver events nowhere while reporting success: a 404
# and a 201 are both "the server answered". Putting the path here would produce
# http://host:8000/internal/ai/events/api/v1/ingest/events and a run that spools everything.
TRINETRA_INGEST_URL=http://localhost:8000
TRINETRA_INGEST_TOKEN=

# --- model hub ---------------------------------------------------------------
# Read token for pulling checkpoints. A read-scoped token is sufficient; anything
# broader should not be on a shared machine.
HF_TOKEN=
